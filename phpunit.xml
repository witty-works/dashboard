<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_DRIVER" value="array"/>
        <server name="CACHE_STORE" value="array"/>
        <!--
            Tests run against a real MariaDB schema because the migration history
            relies on MySQL-specific DDL that SQLite cannot replay.
            Connection details come from .env; only the database name is pinned
            here so a test run can never touch the development database.
        -->
        <server name="DB_DATABASE" value="testing"/>
        <server name="DEBUGBAR_ENABLED" value="false"/>
        <!--
            Saving a user or team dispatches a sync job to the NLP API, and
            QUEUE_CONNECTION=sync runs it inline. Blanking the endpoints makes the
            job take its own no-op branch instead of calling out over the network.
        -->
        <server name="APP_NLP_API_SYNC_ENDPOINT" value=""/>
        <server name="APP_NLP_API_SYNC_ENDPOINT_2" value=""/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
