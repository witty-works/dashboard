APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://dashboard.lndo.site/
APP_NAME=dashboard

APP_NLP_API_SYNC_ENDPOINT="http://127.0.0.1:8000"
APP_NLP_API_SYNC_USER=
APP_NLP_API_SYNC_PASSWORD=
APP_NLP_API_SYNC_CONFIGS=false

# Set to false when the backend has no LLM support, to disable Witty GPT
APP_LLM_ENABLED=true

BROWSER_VERSION_CHROME=""
BROWSER_VERSION_EDGE=""
BROWSER_VERSION_FIREFOX=""

# OAuth2 (Passport) — the browser extensions authenticate with
# authorization_code + PKCE against /oauth/authorize and /oauth/token.
# Run `php artisan passport:keys` once per environment, then
# `php artisan passport:extension-client` to provision the client below.
#
# Redirect URIs are matched byte-for-byte; comma separated. Chrome/Opera derives
# from the pinned manifest key. Firefox is sha1 of the braced extension ID:
#   printf '%s' '{4b376457-9460-4891-b28a-60499c2e3343}' | shasum -a 1
# Both values for the shipping extension (see docs/oauth.md):
#   https://meojhlodfiihbjkcnehkdcgncnhgagog.chromiumapp.org/,https://e74fe0942ca5c6c17185e1e4d5798b0ecd5a36d4.extensions.allizom.org/
#
# Leave EXTENSION_OAUTH_CLIENT_ID empty the first time: passport:extension-client
# prints the UUID it generated, and refuses to run if this is set to an id that
# does not exist rather than quietly creating a second client. The value is a
# UUID as of Passport 13 — an environment carrying the old integer ids needs the
# oauth_* tables recreated, which changes the id everywhere it is configured.
EXTENSION_OAUTH_CLIENT_NAME="Witty Browser Extension"
EXTENSION_OAUTH_CLIENT_ID=
EXTENSION_OAUTH_REDIRECT_URIS=
# Clients allowed to skip the consent screen. Set to EXTENSION_OAUTH_CLIENT_ID.
PASSPORT_FIRST_PARTY_CLIENTS=
# ISO-8601 durations. Access tokens are short because the extension stores them
# where any code in the browser profile can read them.
PASSPORT_ACCESS_TOKEN_TTL=PT1H
PASSPORT_REFRESH_TOKEN_TTL=P30D

LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

POSTHOG_ENABLED=true
POSTHOG_JS_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=
POSTHOG_DEBUG=false
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_INSIGHTS_CACHE_TIME=3600
POSTHOG_DASHBOARD_USER_ID="dashboard-user:17"
POSTHOG_DASHBOARD_TEAM_ID="dashboard-team:9"
POSTHOG_RATE_LIMIT=16
POSTHOG_RATE_INTERVAL_SECONDS=60
POSTHOG_RATE_MULTIPLIER=3

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel


SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_LOG_LEVEL=
SENTRY_TRACE_QUEUE_ENABLED=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MAIL_DRIVER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

MAIL_FROM_ADDRESS=YOUR_EMAIL_FROM_ADDRESS
MAIL_FROM_NAME=YOU_FROM_NAME

HELPHERO_JS_ENABLED=true