{
    "name": "wityworks/dashboard",
    "type": "project",
    "description": "The Witty Dashboard",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-debugbar": "^4.0",
        "bensampo/laravel-embed": "^3.0",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "jfcherng/php-diff": "^6.16",
        "kineticamobile/lumki": "^0.2.0",
        "laravel/cashier": "^15.0",
        "laravel/framework": "^13.0",
        "laravel/jetstream": "^5.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.2",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^3.4",
        "mcamara/laravel-localization": "^2.0",
        "p3k/emoji-detector": "^1.0.0",
        "platformsh/laravel-bridge": "^2.2",
        "posthog/posthog-php": "^3.0",
        "sentry/sentry-laravel": "^4.0",
        "socialiteproviders/manager": "^4.8",
        "spatie/laravel-failed-job-monitor": "^4.3",
        "spatie/laravel-google-fonts": "^1.2",
        "spatie/laravel-rate-limited-job-middleware": "^2.2",
        "spatie/laravel-slack-alerts": "^1.1",
        "symfony/http-client": "^7.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi",
            "@php artisan ide-helper:generate"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
