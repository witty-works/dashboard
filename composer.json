{
    "name": "wityworks/dashboard",
    "type": "project",
    "description": "The Witty Dashboard",
    "require": {
        "php": "^7.3|^8.0",
        "barryvdh/laravel-debugbar": "^3.6",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "joelbutcher/socialstream": "^3.2",
        "kineticamobile/lumki": "dev-main",
        "laravel/framework": "^9",
        "laravel/jetstream": "^2.4",
        "laravel/sanctum": "^2.11",
        "laravel/socialite": "^5.2",
        "laravel/spark-stripe": "^1.0",
        "laravel/tinker": "^2.5",
        "livewire/livewire": "^2.5",
        "mcamara/laravel-localization": "^1.6",
        "platformsh/laravel-bridge": "^2.2",
        "posthog/posthog-php": "^2.1",
        "sentry/sentry-laravel": "^2.9",
        "socialiteproviders/azureadb2c": "dev-multiple-policies",
        "themsaid/laravel-langman": "dev-master"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.10",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^5.10 | ^6.0",
        "phpunit/phpunit": "^9.5.10",
        "tio/laravel": "dev-remove-array-align-laravel-8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Spark\\": "spark",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "exclude-from-classmap": [
            "vendor/laravel/spark-stripe/src/Countries.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi",
            "@php artisan ide-helper:generate"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:lsmith77/AzureADB2C.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:witty-works/laravel-langman.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:lsmith77/laravel.git"
        },
        {
            "type": "composer",
            "url": "https://spark.laravel.com"
        }
    ],
    "listen-stripe": [
        "stripe listen --forward-to http://spark-test.test/spark/webhook"
    ]
}